{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pack 137 News Builder",
  "version": "../package.json",
  "identifier": "org.pack137.newsbuilder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Pack 137 News Builder",
        "width": 1200,
        "height": 860,
        "minWidth": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Productivity",
    "shortDescription": "Turns TroopTrack announcements into on-brand HTML and builds the Pack 137 Stories letter.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.3",
      "signingIdentity": "-"
    }
  }
}
